# Application
APP_NAME=QC Photo System
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://qc_user:change-me@localhost:15432/smart_qc_capture_system

# Feishu self-built app and Bitable
FEISHU_APP_ID=cli_xxxxxxxxx
FEISHU_APP_SECRET=CHANGE_ME
FEISHU_BITABLE_APP_TOKEN=CHANGE_ME
FEISHU_BITABLE_TABLE_ID=tblxxxxxxxx
FEISHU_BITABLE_ORDER_TABLE_ID=tblxxxxxxxx
FEISHU_BITABLE_ORDER_VIEW_ID=vewxxxxxxxx
FEISHU_BITABLE_INSPECTION_TASK_VIEW_ID=vewxxxxxxxx
# Send this value in the X-QC-Sync-Secret request header of Feishu Automation.
FEISHU_SYNC_WEBHOOK_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# Aliyun OSS
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=qc-photo-archive
OSS_ACCESS_KEY_ID=CHANGE_ME
OSS_ACCESS_KEY_SECRET=CHANGE_ME
OSS_PREFIX=orders

# Web client / security
WEB_ORIGIN=https://your-domain.example.com
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
SESSION_MAX_AGE_SECONDS=28800
# Keep false until application-identity Contact permissions are configured.
FEISHU_SYNC_DEPARTMENTS=false
