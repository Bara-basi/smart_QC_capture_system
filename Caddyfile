{
    email {$ACME_EMAIL}
}

# APP_ORIGIN supports both https://qc.example.com (domain mode) and
# http://203.0.113.10 (IP mode). Explicit http keeps Caddy from attempting
# ACME certificates, which cannot be issued for a bare IP address.
{$APP_ORIGIN} {
    encode zstd gzip
    request_body {
        # FastAPI limits each image to 15 MB; allow a multi-photo submission.
        max_size 100MB
    }

    @api path /api/*
    reverse_proxy @api api:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    @health path /health
    reverse_proxy @health api:8000

    # Vite fingerprints production assets. Cache them aggressively so repeat
    # visits in Feishu's iOS WebView do not re-download the application shell.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    root * /srv
    try_files {path} /index.html
    file_server
}
