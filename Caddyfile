{
    email {$ACME_EMAIL}
}

# APP_ORIGIN supports both https://qc.example.com (domain mode) and
# http://203.0.113.10 (IP mode). Explicit http keeps Caddy from attempting
# ACME certificates, which cannot be issued for a bare IP address.
{$APP_ORIGIN} {
    encode zstd gzip
    request_body {
        # FastAPI limits each image to 15 MB; allow a multi-photo submission.
        max_size 100MB
    }

    # `handle` blocks are mutually exclusive. Keep API requests out of the
    # SPA fallback below; otherwise try_files rewrites them to index.html.
    handle /api/* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle /health {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Vite fingerprints production assets. Cache them aggressively so repeat
    # visits in Feishu's iOS WebView do not re-download the application shell.
    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        root * /srv
        file_server
    }

    handle {
        # Always revalidate the SPA entry so a deployment can point clients to
        # the newly fingerprinted JavaScript bundle immediately.
        header Cache-Control "no-cache"
        root * /srv
        try_files {path} /index.html
        file_server
    }

}
