{
    email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
    encode zstd gzip
    request_body {
        # FastAPI limits each image to 15 MB; allow a multi-photo submission.
        max_size 100MB
    }

    @api path /api/*
    reverse_proxy @api api:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    @health path /health
    reverse_proxy @health api:8000

    root * /srv
    try_files {path} /index.html
    file_server
}
