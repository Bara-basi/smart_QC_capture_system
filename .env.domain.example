# Public HTTPS URL of the QC application. Replace this placeholder with the
# real domain before applying the shared-edge deployment.
APP_ORIGIN=https://qc.example.com
ACME_EMAIL=ops@example.com

# Used only by the PostgreSQL container. Keep the same values as the existing
# production database when upgrading an existing deployment.
POSTGRES_DB=smart_qc_capture_system
POSTGRES_USER=qc_user
POSTGRES_PASSWORD=change-me
