# Public HTTPS URL of the QC application. Enable this only after mtsco.cn has
# passed ICP filing and qc.mtsco.cn resolves to this server.
APP_ORIGIN=https://qc.mtsco.cn
ACME_EMAIL=ops@mtsco.com

# Used only by the PostgreSQL container. Keep the same values as the existing
# production database when upgrading an existing deployment.
POSTGRES_DB=smart_qc_capture_system
POSTGRES_USER=qc_user
POSTGRES_PASSWORD=change-me
