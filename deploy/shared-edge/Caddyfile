{
	email {$ACME_EMAIL}
}

# QC photo system. Forwards to the internal-only QC web container.
{$QC_DOMAIN} {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	reverse_proxy qc-capture-web:80 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}

# MT Alloy admin gateway, already attached to the QC shared Docker network.
{$ADMIN_DOMAIN} {
	encode zstd gzip
	reverse_proxy mtalloy-website-admin:80 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}

# Public marketing website.
{$WEBSITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy mtalloy-website:80 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}

# Canonical redirect for the website's apex domain.
{$WEBSITE_APEX_DOMAIN} {
	redir https://{$WEBSITE_DOMAIN}{uri} permanent
}
