# One company-owned domain and three subdomains. All DNS names below must
# resolve to the server's public IP before the edge proxy is started.
QC_DOMAIN=qc.example.com
ADMIN_DOMAIN=admin.example.com
WEBSITE_DOMAIN=www.example.com
WEBSITE_APEX_DOMAIN=example.com

# Used by Let's Encrypt for certificate expiry notifications.
ACME_EMAIL=ops@example.com
