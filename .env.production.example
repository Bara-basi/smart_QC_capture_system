# Public domain. Point its A/AAAA record to this server before starting Caddy.
APP_DOMAIN=qc.example.com
ACME_EMAIL=ops@example.com

# Used only by the PostgreSQL container. Use a long unique password.
POSTGRES_DB=smart_qc_capture_system
POSTGRES_USER=qc_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
