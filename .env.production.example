# Choose one public entry point:
# - https://qc.example.com for a domain with automatic TLS certificates; or
# - http://203.0.113.10 for an IP-only deployment (no certificate / no domain).
APP_ORIGIN=http://203.0.113.10
ACME_EMAIL=ops@example.com

# Used only by the PostgreSQL container. Use a long unique password.
POSTGRES_DB=smart_qc_capture_system
POSTGRES_USER=qc_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
