{
    email {$ACME_EMAIL}
    # Clients commonly omit TLS SNI when connecting to an IP literal. Without
    # a default, Caddy cannot select the IP certificate during the handshake.
    default_sni {$APP_IP}
}

# Public-IP deployment. The certificate is issued and renewed by Certbot on
# the host, because IP certificates use Let's Encrypt's short-lived profile.
https://{$APP_IP} {
    tls /etc/letsencrypt/live/{$APP_IP}/fullchain.pem /etc/letsencrypt/live/{$APP_IP}/privkey.pem
    encode zstd gzip
    request_body {
        max_size 100MB
    }

    # `handle` blocks are mutually exclusive. Keep API requests out of the
    # SPA fallback below; otherwise try_files rewrites them to index.html.
    handle /api/* {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle /health {
        reverse_proxy api:8000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle /assets/* {
        header Cache-Control "public, max-age=31536000, immutable"
        root * /srv
        file_server
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

}

# This route lets Certbot renew the IP certificate without stopping Caddy.
http://{$APP_IP} {
    handle /.well-known/acme-challenge/* {
        root * /var/www/certbot
        file_server
    }
    redir https://{$APP_IP}{uri} permanent
}
