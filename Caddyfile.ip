{
    email {$ACME_EMAIL}
}

# Public-IP deployment. The certificate is issued and renewed by Certbot on
# the host, because IP certificates use Let's Encrypt's short-lived profile.
https://{$APP_IP} {
    tls /etc/letsencrypt/live/{$APP_IP}/fullchain.pem /etc/letsencrypt/live/{$APP_IP}/privkey.pem
    encode zstd gzip
    request_body {
        max_size 100MB
    }

    @api path /api/*
    reverse_proxy @api api:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }

    @health path /health
    reverse_proxy @health api:8000

    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    root * /srv
    try_files {path} /index.html
    file_server
}

# This route lets Certbot renew the IP certificate without stopping Caddy.
http://{$APP_IP} {
    handle /.well-known/acme-challenge/* {
        root * /var/www/certbot
        file_server
    }
    redir https://{$APP_IP}{uri} permanent
}
